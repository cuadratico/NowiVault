<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <TextView
        android:layout_width="220dp"
        android:layout_height="wrap_content"
        android:fontFamily="@font/pixel"
        app:layout_constraintEnd_toEndOf="@id/all_icon_conf"
        app:layout_constraintStart_toStartOf="@id/all_icon_conf"
        app:layout_constraintBottom_toTopOf="@id/all_icon_conf"
        android:layout_marginBottom="20dp"
        android:textColor="@color/n_white"
        android:textSize="19dp"
        android:gravity="center"
        android:text="Edit the icon and its functionalities"
        />

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/all_icon_conf"
        android:layout_width="350dp"
        android:layout_height="200dp"
        android:backgroundTint="@color/b_black"
        android:background="@drawable/corner_25"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        >

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/icons_all"
            android:layout_width="wrap_content"
            android:layout_height="50dp"
            android:backgroundTint="@color/black"
            android:background="@drawable/corner_25"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            android:layout_marginTop="20dp"
            >


            <com.google.android.material.imageview.ShapeableImageView
                android:id="@+id/icon_1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/setting"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                android:layout_marginStart="10dp"
                />

            <com.google.android.material.imageview.ShapeableImageView
                android:id="@+id/edit_icon"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/delete_all"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toEndOf="@id/icon_1"
                android:layout_marginStart="20dp"
                />

            <com.google.android.material.imageview.ShapeableImageView
                android:id="@+id/icon_2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/bidirection_arrows"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toEndOf="@id/edit_icon"
                app:layout_constraintEnd_toEndOf="parent"
                android:layout_marginStart="20dp"
                android:layout_marginEnd="10dp"
                />



        </androidx.constraintlayout.widget.ConstraintLayout>

        <View
            android:id="@+id/center"
            android:layout_width="1dp"
            android:layout_height="1dp"
            app:layout_constraintEnd_toEndOf="@id/icons_all"
            app:layout_constraintStart_toStartOf="@id/icons_all"
            app:layout_constraintTop_toBottomOf="@id/icons_all"
            />

        <TextView
            android:id="@+id/icon_info"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Icon"
            android:fontFamily="@font/pixel"
            android:textColor="@color/n_blue"
            android:textSize="17dp"
            app:layout_constraintTop_toBottomOf="@id/icons_all"
            app:layout_constraintEnd_toStartOf="@id/center"
            app:layout_constraintStart_toStartOf="parent"
            android:layout_marginTop="20dp"
            />

        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/edit_icons_button"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintTop_toBottomOf="@id/icon_info"
            app:layout_constraintEnd_toEndOf="@id/icon_info"
            app:layout_constraintStart_toStartOf="@id/icon_info"
            android:layout_marginTop="10dp"
            android:src="@drawable/edit"
            />

        <androidx.appcompat.widget.AppCompatCheckBox
            android:id="@+id/dialog_show_check"
            android:layout_width="wrap_content"
            android:layout_height="30dp"
            app:layout_constraintTop_toBottomOf="@id/edit_icons_button"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            android:text="Explanation of the modes"
            android:fontFamily="monospace"
            />

        <TextView
            android:id="@+id/fun_info"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Functionality"
            android:fontFamily="@font/pixel"
            android:textColor="@color/n_blue"
            android:textSize="17dp"
            app:layout_constraintTop_toBottomOf="@id/icons_all"
            app:layout_constraintStart_toEndOf="@id/center"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_marginTop="20dp"
            />

        <androidx.appcompat.widget.AppCompatSpinner
            android:id="@+id/fun_spinner"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintTop_toBottomOf="@id/fun_info"
            app:layout_constraintEnd_toEndOf="@id/fun_info"
            app:layout_constraintStart_toStartOf="@id/fun_info"
            android:layout_marginTop="10dp"
            />

    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.constraintlayout.widget.ConstraintLayout>